// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id     Int     @id @default(autoincrement())
  user_name   String? @unique
  user_pass   String? // nullable for Google login
  user_fname  String?
  user_lname  String?
  user_email  String  @unique
  user_phone  String?
  user_img    String?
  user_status Int     @default(1)
  google_id   String? @unique
  admin       Admin[]
}

model Admin {
  admin_id     Int  @id @default(autoincrement())
  user_id      Int
  admin_status Int  @default(1)
  user         User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model TableMap {
  id     Int     @id @default(autoincrement())
  label  String  @unique
  x      Int     @default(0)
  y      Int     @default(0)
  active Boolean @default(true)

  seatOptionId Int?
  seatOption   SeatOption? @relation(fields: [seatOptionId], references: [id])

  tableTypeId Int?
  tableType   TableType? @relation(fields: [tableTypeId], references: [id])

  // เปลี่ยนจาก tags (ที่เป็น TableTag[]) เป็น additionalInfo (String?)
  additionalInfo String? // <--- Field สำหรับ Textarea/ข้อความเพิ่มเติม

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeatOption {
  id     Int        @id @default(autoincrement())
  seats  Int
  tables TableMap[]
}

model TableType {
  id     Int        @id @default(autoincrement())
  name   String
  tables TableMap[]
}

model Typefood {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  type_status Int          @default(1)
  FoodMenus   FoodMenuType[]
}

model FoodMenu {
  menu_id        Int           @id @default(autoincrement())
  menu_name      String
  menu_price     Int
  menu_description String?
  menu_status    Int           @default(1)
  MenuImages     MenuImage[]
  Typefoods      FoodMenuType[]
}

// ตารางกลางสำหรับความสัมพันธ์ Many-to-Many
model FoodMenuType {
  foodMenuTypeId Int          @id @default(autoincrement()) // Primary Key ของตารางเชื่อมโยง
  foodMenuId     Int
  typefoodId     Int
  foodMenu       FoodMenu     @relation(fields: [foodMenuId], references: [menu_id], onDelete: Cascade)
  typefood       Typefood     @relation(fields: [typefoodId], references: [id], onDelete: Cascade)
}

model MenuImage {
  menu_image_id Int      @id @default(autoincrement())
  menu_id       Int
  menu_image    String
  menu_status   Int      @default(0)
  foodMenu      FoodMenu @relation(fields: [menu_id], references: [menu_id], onDelete: Cascade)
}

