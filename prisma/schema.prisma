// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id     Int     @id @default(autoincrement())
  user_name   String? @unique
  user_pass   String? // nullable for Google login
  user_fname  String?
  user_lname  String?
  user_email  String  @unique
  user_phone  String?
  user_img    String?
  user_status Int     @default(1)
  google_id   String? @unique
  admin       Admin[]
}

model Admin {
  admin_id     Int  @id @default(autoincrement())
  user_id      Int
  admin_status Int  @default(1)
  user         User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}
model TableMap {
  id              Int         @id @default(autoincrement())
  label           String      @unique
  x               Int         @default(0)
  y               Int         @default(0)
  active          Boolean     @default(true)

  seatOptionId    Int?
  seatOption      SeatOption? @relation(fields: [seatOptionId], references: [id])

  tableTypeId     Int?
  tableType       TableType?  @relation(fields: [tableTypeId], references: [id])

  // เปลี่ยนจาก tags (ที่เป็น TableTag[]) เป็น additionalInfo (String?)
  additionalInfo  String?     // <--- Field สำหรับ Textarea/ข้อความเพิ่มเติม

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model SeatOption {
  id     Int        @id @default(autoincrement())
  seats  Int
  tables TableMap[]
}

model TableType {
  id     Int        @id @default(autoincrement())
  name   String
  tables TableMap[]
}

model Typefood {
  id     Int        @id @default(autoincrement())
  name   String
  type_status Int     @default(1)
}



